# Database URL
# Note: Use the same DATABASE_URL as the root .env
# Neon on Vercel injects DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct).
# Migrations use the direct URL when it is set. Local Docker only needs DATABASE_URL.
DATABASE_URL=postgres://user:password@db:5432/mydb

# Server configuration
BACKEND_PORT=3001

# CORS configuration
# Note: Change to production domain when deploying
FRONTEND_ORIGIN=http://localhost:3000
