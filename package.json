{
  "scripts": {
    "prepare": "husky install",
    "format:all": "npm run format --workspace=apps/frontend && npm run format --workspace=apps/backend",
    "studio": "cd apps/backend && DATABASE_URL=postgres://user:password@127.0.0.1:55432/mydb npx prisma studio --port 5555",
    "storybook": "npm run storybook --workspace=frontend"
  },
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": "prettier --write"
  }
}
