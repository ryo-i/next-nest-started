{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/frontend",
      "framework": "nextjs",
      "installCommand": "cd ../.. && HUSKY=0 npm ci"
    },
    "backend": {
      "root": "apps/backend",
      "framework": "nestjs",
      "installCommand": "cd ../.. && HUSKY=0 npm ci",
      "functions": {
        "src/main.ts": {
          "includeFiles": "../../node_modules/.prisma/client/query_compiler_bg.wasm"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/persons", "destination": { "service": "backend" } },
    { "source": "/persons/(.*)", "destination": { "service": "backend" } },
    { "source": "/api", "destination": { "service": "backend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
